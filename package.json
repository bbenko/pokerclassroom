{
  "name": "pokerclassroom",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A six-player poker trainer that runs entirely in your browser.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "simulate": "node scripts/simulate.cjs",
    "eval:coach": "node scripts/evaluate-coach.cjs",
    "test:audit": "python3 -m unittest discover -s tests -p test_history_audit.py",
    "audit:histories": "python3 scripts/review-histories.py"
  },
  "engines": {
    "node": ">=20"
  }
}
